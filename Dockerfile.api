# SWARAJ API Dockerfile
# Multi-stage build for minimal attack surface

FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libpoppler-cpp-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy only what's needed for dependency installation
COPY pyproject.toml .
COPY README.md .

# Install Python dependencies (no cloud calls, from PyPI cache if available)
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r pyproject.toml

# Runtime stage
FROM python:3.11-slim-bookworm AS runtime

WORKDIR /app

# Create non-root user
RUN groupadd --gid 1000 swaraj && \
    useradd --uid 1000 --gid 1000 --shell /bin/bash --create-home swaraj

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpoppler-cpp24 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy wheels from builder
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels /wheels/* \
    && rm -rf /wheels

# Copy application code
COPY src/ /app/src/
COPY scripts/verify_certificate.py /app/scripts/
COPY policies/ /app/policies/
COPY users.json /app/

# Create directories with correct permissions
RUN mkdir -p /app/data/keys /app/data/audit /app/data/workspace /app/data/artifacts /app/logs /app/models \
    && chown -R swaraj:swaraj /app/data /app/logs \
    && chmod 755 /app/data /app/logs \
    && chmod 700 /app/data/keys

# Switch to non-root user
USER swaraj

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/health || exit 1

# Expose port (internal network only)
EXPOSE 8000

# Run the application
CMD ["python", "-m", "uvicorn", "swaraj.api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Security notes:
# - No root access
# - Minimal packages
# - No cloud dependencies at runtime
# - Private key directory (data/keys) has 700 permissions
# - Read-only where possible
