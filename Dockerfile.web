# SWARAJ Web (Frontend) Dockerfile
# Multi-stage build: Node.js build -> Nginx serve

FROM node:20-alpine AS builder

WORKDIR /build

# Copy package files
COPY package*.json ./

# Install dependencies (offline if cache available)
RUN npm ci --only=production 2>/dev/null || npm install --only=production

# Copy source code
COPY . .

# Build the frontend
RUN npm run build

# Production stage: Nginx
FROM nginx:alpine

# Remove default config and static files
RUN rm -rf /usr/share/nginx/html/*

# Copy custom nginx config (if exists, otherwise use default)
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /build/dist /usr/share/nginx/html

# Create non-root user context (nginx user already exists)
USER nginx

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/ || exit 1

# Serve static files only
# NO access to backend, keys, or sensitive data
CMD ["nginx", "-g", "daemon off;"]

# Security notes:
# - Static files only
# - No Node.js runtime in production
# - No access to private keys
# - No access to backend data directories
# - Read-only filesystem where possible
